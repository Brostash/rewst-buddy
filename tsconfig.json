{
	"compilerOptions": {
		"module": "es2020",
		"target": "es2022",
		"outDir": "dist",
		"rootDir": ".",
		"baseUrl": "src",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"paths": {
			"@models": ["models/index.ts"],
			"@capabilities": ["capabilities/index.ts"],
			"@mcp": ["mcp/index.ts"],
			"@commands": ["commands/index.ts"],
			"@sessions": ["sessions/index.ts"],
			"@utils": ["utils/index.ts"],
			"@global": ["context/index.ts"],
			"@ui": ["ui/index.ts"],
			"@server": ["server/index.ts"],
			"@events": ["events/index.ts"],
			"@test": ["test/helpers/index.ts"],
			"@workflow": ["workflow/index.ts"]
		},
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"noErrorTruncation": true
	},
	"include": ["src/**/*.ts", "./node_modules/vscode/vscode.d.ts", "./node_modules/vscode/lib/*"],
	"watchOptions": {
		// Use native file system events for files and directories
		"watchFile": "useFsEvents",
		"watchDirectory": "useFsEvents",
		// Poll files for updates more frequently
		// when they're updated a lot.
		"fallbackPolling": "dynamicPriority",
		// Don't coalesce watch notification
		"synchronousWatchDirectory": true,
		// Finally, two additional settings for reducing the amount of possible
		// files to track  work from these directories
		"excludeDirectories": ["**/node_modules", "dist", ".LOCAL"],
		"excludeFiles": []
	}
}
