.vscode/**
.vscode-test/**
.claude/**
.LOCAL/**
.husky/**
.github/**
node_modules/**
src/**
scripts/**
changelog.d/**

# Secrets / local env (never ship)
.env
.env.*

# Build and config files
.coderabbit.yaml
esbuild.mjs
vitest.config.ts
vitest.suites.mjs
tsconfig.json
**/tsconfig.json
eslint.config.mjs
